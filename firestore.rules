rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Laravel/MySQL is the source of truth. Firestore is a server-written,
    // lightweight real-time mirror for Flutter clients.
    match /orders/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if false;
    }

    match /addresses/{addressId} {
      allow read: if true;
      allow write: if false;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
